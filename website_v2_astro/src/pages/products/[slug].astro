    ],
    values: [
      { title: '数据转化利用', description: '将固废、危废、医废等过程记录转化为绿色管理基础数据，提升数据价值。', tone: 'tone-green', icon: 'workflow' },
      { title: '协同分析能力', description: '支持园区和集团单位开展减污降碳协同分析，辅助绿色低碳目标实现。', tone: 'tone-cyan', icon: 'chart' },
      { title: '管理趋势掌握', description: '辅助管理部门掌握重点环节和变化趋势，支持管理决策优化。', tone: 'tone-blue', icon: 'monitor' },
      { title: '持续发展支撑', description: '为后续碳核算、绩效评估和绿色低碳管理持续迭代提供稳定数据支撑。', tone: 'tone-green', icon: 'shield' },
    ],
    ctaDescription: '欢迎预约沟通，我们将根据您的单位类型和管理需求提供专项方案建议。',
  },
};

const meta = productPageMeta[slug!];
const publicRoot = fileURLToPath(new URL('../../../public', import.meta.url));
const heroImageExists = existsSync(fileURLToPath(new URL(`.${meta.heroImage}`, `file://${publicRoot}/`)));
---

<BaseLayout bodyClass="v1-inner-page" title={`${product.displayName} | 智感云`} description={product.excerpt}>
  <SiteHeader currentPath={Astro.url.pathname} />

  <main>
    <section class="v1-page-hero">
      <div class="v1-container">
        <div class="v1-breadcrumb">
          <a href="/">首页</a>
          <span class="v1-breadcrumb-sep">/</span>
          <a href="/products/">产品与解决方案</a>
          <span class="v1-breadcrumb-sep">/</span>
          <span>{product.shortName}</span>
        </div>
        <div class="v1-page-hero-inner">
          <div class="v1-page-hero-text">
            <span class="v1-section-label">{meta.heroLabel}</span>
            <h1 class="v1-page-hero-title v1-product-hero-title"><span>{product.displayName}</span></h1>
            <p class="v1-product-hero-english">{product.englishName}</p>
            <p class="v1-page-hero-subtitle">{product.heroSummary}</p>
            <div class="v1-product-hero-tags">
              {meta.heroTags.map((tag) => <span class="v1-product-hero-tag">{tag}</span>)}
            </div>
          </div>
          <div class="v1-page-hero-media v1-product-page-hero-media">
            {heroImageExists ? (
              <img src={meta.heroImage} alt={product.name} loading="lazy" />
            ) : (
              <div class="v1-product-page-hero-fallback" aria-hidden="true"></div>
            )}
          </div>
        </div>
      </div>
    </section>

    <section class="v1-section">
      <div class="v1-container">
        <div class="v1-product-section-header">
          <span class="v1-section-label">产品定位</span>
          <h2 class="v1-section-title">{meta.positioningTitle}</h2>
          <p class="v1-section-subtitle v1-product-section-subtitle">{product.positioning}</p>
        </div>
        {meta.positioningTags && (
          <div class="v1-product-positioning-box">
            <div class="v1-product-positioning-label">覆盖场景</div>
            <div class="v1-product-positioning-tags">
              {meta.positioningTags.map((tag) => <span class="v1-product-hero-tag">{tag}</span>)}
            </div>
          </div>
        )}
      </div>
    </section>

    {meta.painCards && (
      <section class="v1-section v1-section-surface v1-product-detail-offset">
        <div class="v1-container">
          <div class="v1-section-header v1-section-header-center">
            <span class="v1-section-label">业务痛点</span>
            {meta.painTitle && <h2 class="v1-section-title">{meta.painTitle}</h2>}
          </div>
          <div class="v1-pain-grid">
            {meta.painCards.map((item) => (
              <article class="v1-pain-card">
                <h3 class="v1-pain-card-title">{item.title}</h3>
                <p class="v1-pain-card-desc">{item.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="v1-section">
      <div class="v1-container">
        <div class="v1-section-header v1-section-header-center">
          <span class="v1-section-label">{meta.featureLabel}</span>
          {meta.featureTitle && <h2 class="v1-section-title">{meta.featureTitle}</h2>}
        </div>
        <div class="v1-feature-grid">
          {meta.features.map((feature) => (
            <article class="v1-feature-card">
              <div class:list={['v1-feature-icon', 'v1-icon-badge', feature.tone]}>
                <Icon name={feature.icon} class="h-6 w-6" />
              </div>
              <h3 class="v1-feature-title">{feature.title}</h3>
              <p class="v1-feature-desc">{feature.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    {meta.flowTitle && (
      <section class="v1-section v1-section-surface v1-product-detail-offset">
        <div class="v1-container">
          <div class="v1-section-header v1-section-header-center">
            <span class="v1-section-label">业务流程</span>
            <h2 class="v1-section-title">{meta.flowTitle}</h2>
          </div>
          <div class="v1-flow-steps">
            {product.processSteps.map((step, index) => (
              <>
                <div class="v1-flow-node">
                  <div class="v1-flow-node-circle">{index + 1}</div>
                  <div class="v1-flow-node-label">{step}</div>
                </div>
                {index < product.processSteps.length - 1 && <div class="v1-flow-connector"></div>}
              </>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="v1-section v1-section-surface">
      <div class="v1-container">
        <div class="v1-section-header v1-section-header-center">
          <span class="v1-section-label">应用价值</span>
          {meta.valueTitle && <h2 class="v1-section-title">{meta.valueTitle}</h2>}
        </div>
        <div class="v1-value-grid">
          {meta.values.map((item) => (
            <article class="v1-value-card">
              <div class:list={['v1-value-icon', 'v1-icon-badge', item.tone]}>
                <Icon name={item.icon} class="h-6 w-6" />
              </div>
              <h3 class="v1-value-title">{item.title}</h3>
              <p class="v1-value-desc">{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="v1-section v1-cta-section">
      <div class="v1-container">
        <div class="v1-cta-inner">
          <h2 class="v1-cta-title">{product.ctaTitle}</h2>
          <p class="v1-cta-desc">{meta.ctaDescription}</p>
          <a href="/contact/" class="v1-btn v1-btn-primary v1-btn-lg">预约产品演示</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>