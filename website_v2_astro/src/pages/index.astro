---

<BaseLayout bodyClass="home-page">
	<SiteHeader currentPath={Astro.url.pathname} />

	<main style={`--brand-logo:url('${siteImages.brand.logo}');`}>
		<section class="hero">
			<div class="container">
				<div class="hero-inner">
					<div class="hero-text">
						<div class="hero-tags">
							{homeHeroBullets.map((item) => <span class="tag">{item.label}</span>)}
						</div>
						<h1 class="hero-title"><span><em>AIoT</em> 赋能医疗卫生</span><span>与生态环境智慧合规</span></h1>
						<p class="hero-subtitle">{homeHero.subtitle}</p>
						<p class="hero-note">{homeHero.supporting}</p>
						<div class="hero-btns">
							<a href="/contact/" class="btn btn-primary btn-lg"><span class="btn-label">预约产品演示</span><span class="btn-icon" aria-hidden="true" set:html={buttonArrowIcon}></span></a>
							<a href="/products/" class="btn btn-secondary btn-lg"><span class="btn-label">查看解决方案</span><span class="btn-icon" aria-hidden="true" set:html={buttonArrowIcon}></span></a>
						</div>
					</div>
					<div class="hero-visual">
						<HeroVisual />
					</div>
				</div>
			</div>
		</section>

		<section class="section stats-section surface-neutral">
			<div class="container">
				<div class="section-header center">
					<span class="section-label">OPM 大数据</span>
					<h2 class="section-title">800+ 客户选择智感云</h2>
					<p class="section-subtitle">这些数字，来自真实客户的长期使用。智感云围绕医疗废物、危险废物、智慧卫监、消毒灭菌监测等业务，持续服务医疗机构、监管部门、生态环境 / 危废相关单位及园区集团客户。</p>
				</div>
				<div class="stats-grid">
					{stats.map((item) => (
						<div class="stat-card">
							<div class="stat-number">{item.value}</div>
							<div class="stat-label">{item.label}</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="section product-overview-section surface-neutral" id="products">
			<div class="container">
				<div class="section-header center">
					<span class="section-label">产品与解决方案</span>
					<h2 class="section-title">产品与解决方案</h2>
					<p class="section-subtitle">面向医疗卫生、生态环境、公共卫生监督与院感合规场景，提供可部署、可追溯、可扩展的数字化解决方案。</p>
				</div>
				<div class="product-tabs" role="tablist" aria-label="产品切换栏">
					{productOrder.map((slug, index) => (
						<button type="button" class={`product-tab ${index === 0 ? 'is-active' : ''}`} role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`product-panel-${productDataKey[slug]}`} id={`product-tab-${productDataKey[slug]}`} data-product={productDataKey[slug]}>
							<span class="product-tab-icon" aria-hidden="true" set:html={productTabIcons[slug]}></span>
							<span class="product-tab-label">{productShortLabels[slug]}</span>
						</button>
					))}
				</div>
				<div class="product-showcase">
					{productOrder.map((slug, index) => {
						const product = productSummaries.find((item) => item.slug === slug)!;
						const meta = productPanelMeta[slug];
						const productKey = productDataKey[slug];
						const href = product.detailReady ? `/products/${slug}/` : '/products/';
						return (
							<article class={`product-panel ${index === 0 ? 'is-active' : ''}`} id={`product-panel-${productKey}`} role="tabpanel" aria-labelledby={`product-tab-${productKey}`} data-product-panel={productKey} hidden={index !== 0}>
								<div class="product-copy">
