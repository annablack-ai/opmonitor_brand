---
import type { ProductGalleryItem } from '@/types/site';

interface Props {
  items: ProductGalleryItem[];
  imagePaths: string[];
}

const { items, imagePaths } = Astro.props;
const galleryId = `gallery-${Math.random().toString(36).slice(2, 10)}`;
const featuredItem = items[0];
const featuredImage = imagePaths[0] ?? imagePaths[0];
---

<div class="grid gap-6 lg:grid-cols-[1.08fr_0.92fr]" data-screenshot-gallery={galleryId}>
  <article class="section-frame overflow-hidden">
    <div class="flex items-start justify-between gap-4 pb-5">
      <div>
        <div class="eyebrow">主界面展示</div>
        <div class="mt-2 text-sm leading-7 text-ink-500">展示关键工作台、业务页面与统计视图的核心界面。</div>
      </div>
      <div class="section-sidecard min-w-[7.5rem] text-right">
        <div class="section-kicker">界面数量</div>
        <div class="mt-2 text-3xl font-semibold tracking-[-0.05em] text-ink-900">{String(items.length).padStart(2, '0')}</div>
      </div>
    </div>
    <div class="image-frame aspect-[16/10] bg-white p-3 md:p-4">
      <img
        src={featuredImage}
        alt={featuredItem?.imageAlt ?? ''}
        class="h-full w-full rounded-[22px] object-cover"
        loading="lazy"
        data-gallery-featured-image
      />
    </div>
    <div class="px-2 pb-2 pt-5 md:px-3">
      <h3 class="mt-3 text-[1.4rem] font-semibold tracking-[-0.03em] text-ink-900" data-gallery-featured-title>{featuredItem?.title}</h3>
      <p class="body-muted mt-3" data-gallery-featured-description>{featuredItem?.description}</p>
    </div>
  </article>

  <div class="grid gap-4">
    {items.map((item, index) => (
      <button
        type="button"
        class={`panel product-visual-card overflow-hidden p-3 text-left transition-all duration-200 ${index === 0 ? 'ring-2 ring-brand-200' : 'hover:-translate-y-0.5 hover:shadow-[var(--shadow-soft)]'}`}
        data-gallery-trigger
        data-image={imagePaths[index] ?? imagePaths[0]}
        data-alt={item.imageAlt}
        data-title={item.title}
        data-description={item.description}
        aria-pressed={index === 0 ? 'true' : 'false'}
      >
        <div class="grid gap-4 sm:grid-cols-[9rem_1fr] sm:items-center">
          <div class="image-frame aspect-[16/10] bg-white p-2">
            <img src={imagePaths[index] ?? imagePaths[0]} alt={item.imageAlt} class="h-full w-full rounded-[16px] object-cover" loading="lazy" />
          </div>
          <div class="pr-2">
            <div class="eyebrow">界面 {String(index + 1).padStart(2, '0')}</div>
            <h4 class="mt-2 text-base font-semibold text-ink-900">{item.title}</h4>
            <p class="mt-2 text-sm leading-7 text-ink-500">{item.description}</p>
          </div>
        </div>
      </button>
    ))}
  </div>
</div>

<script is:inline>
  const galleries = document.querySelectorAll('[data-screenshot-gallery]');

  galleries.forEach((gallery) => {
    const featuredImage = gallery.querySelector('[data-gallery-featured-image]');
    const featuredTitle = gallery.querySelector('[data-gallery-featured-title]');
    const featuredDescription = gallery.querySelector('[data-gallery-featured-description]');
    const triggers = gallery.querySelectorAll('[data-gallery-trigger]');

    const setActive = (trigger) => {
      triggers.forEach((item) => {
        const isActive = item === trigger;
        item.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        item.classList.toggle('ring-2', isActive);
        item.classList.toggle('ring-brand-200', isActive);
      });

      if (featuredImage) {
        featuredImage.setAttribute('src', trigger.getAttribute('data-image') || '');
        featuredImage.setAttribute('alt', trigger.getAttribute('data-alt') || '');
      }
      if (featuredTitle) {
        featuredTitle.textContent = trigger.getAttribute('data-title') || '';
      }
      if (featuredDescription) {
        featuredDescription.textContent = trigger.getAttribute('data-description') || '';
      }
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => setActive(trigger));
    });
  });
</script>