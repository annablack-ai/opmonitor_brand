---
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import type { ProductSummary } from '@/types/site';

interface Props {
  product: ProductSummary;
}

const { product } = Astro.props;
const href = product.detailReady ? `/products/${product.slug}/` : undefined;
---

<article id={`product-${product.slug}`} class="panel product-visual-card p-7 md:p-8">
  <div class="flex items-start justify-between gap-4">
    <div class="flex items-start gap-4">
      <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-50 text-brand-600 shadow-[0_10px_22px_rgba(19,103,220,0.12)]">
        <Icon name={product.icon} class="h-6 w-6" />
      </span>
      <div>
        <div class="eyebrow">{product.category}</div>
        <h3 class="mt-2 text-xl font-semibold text-ink-900">{product.name}</h3>
      </div>
    </div>
    <span class="text-xs font-medium text-ink-400">{product.highlights[0]}</span>
  </div>

  <div class="tech-constellation mt-6 min-h-[13rem] rounded-[22px]">
    <div class="tech-orbit"></div>
    <div class="tech-core scale-[0.72]"></div>
    <span class="tech-node h-3.5 w-3.5" style="left: 18%; top: 32%;"></span>
    <span class="tech-node h-3.5 w-3.5" style="left: 74%; top: 32%;"></span>
    <span class="tech-node h-3 w-3" style="left: 62%; top: 72%;"></span>
    <span class="tech-link" style="left: 20%; top: 34%; width: 28%; transform: rotate(10deg);"></span>
    <span class="tech-link" style="left: 49%; top: 50%; width: 24%; transform: rotate(-18deg);"></span>
  </div>

  <p class="body-muted mt-6">{product.excerpt}</p>

  <div class="mt-5 grid gap-4 md:grid-cols-2">
    <div class="rounded-[18px] bg-white/66 p-4">
      <div class="eyebrow">适用对象</div>
      <div class="mt-3 text-sm leading-7 text-ink-700">{product.targetUsers.join('、')}</div>
    </div>
    <div class="rounded-[18px] bg-white/66 p-4">
      <div class="eyebrow">核心能力</div>
      <div class="mt-3 flex flex-wrap gap-2">
        {product.highlights.map((item) => <span class="chip">{item}</span>)}
      </div>
    </div>
  </div>

  <div class="mt-4 rounded-[18px] bg-white/66 px-4 py-4 text-sm leading-7 text-ink-600">
    <div class="eyebrow mb-2">交付方式</div>
    <div>{product.overview}</div>
  </div>

  <div class="mt-8 flex items-center justify-between gap-4 border-t border-ink-100 pt-5">
    <div class="text-[11px] uppercase tracking-[0.24em] text-ink-400">{product.detailReady ? '正式详情页已可访问' : '详情页待补充'}</div>
    {href ? (
      <Button href={href} variant="text">
        {product.buttonLabel}
        <Icon name="arrow-right" class="h-4 w-4" />
      </Button>
    ) : (
      <span class="text-sm font-medium text-ink-400">详情内容待补充</span>
    )}
  </div>
</article>