import { capabilities, capabilityProcess, homeHero, homeHeroBullets, siteMeta } from '@/data/site';
import { stats } from '@/data/stats';

const productOrder = ['medical-waste', 'hazardous-waste', 'health-supervision', 'sterilization-monitoring', 'endoscope-compliance', 'carbon-management'] as const;
const productShortLabels: Record<string, string> = {
  'medical-waste': '医废追溯',
