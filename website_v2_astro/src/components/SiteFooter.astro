---
import { footerLinkGroups } from '@/data/navigation';
import { siteMeta } from '@/data/site';
import Icon from '@/components/Icon.astro';

const [productGroup, companyGroup] = footerLinkGroups;
---

<footer class="site-footer text-white">
  <div class="container-shell site-footer-grid py-14">
    <div class="site-footer-brand-block">
      <div class="site-footer-brand-head">
        <span class="site-footer-brand-mark">
          <Icon name="logo" class="h-6 w-6" />
        </span>
        <span>
          <span class="site-footer-brand-name">{siteMeta.shortName}</span>
          <span class="site-footer-brand-company">{siteMeta.name}</span>
        </span>
      </div>
      <p class="site-footer-brand-copy">{siteMeta.tagline}</p>
    </div>

    <div class="site-footer-group site-footer-group-products">
      <div class="site-footer-title">{productGroup.title}</div>
      <div class="site-footer-product-links">
        {productGroup.links.map((link) => (
          <a href={link.href} class="site-footer-link site-footer-link-product">{link.label}</a>
        ))}
      </div>
    </div>

    <div class="site-footer-group">
      <div class="site-footer-title">{companyGroup.title}</div>
      <div class="site-footer-link-list">
        {companyGroup.links.map((link) => (
          <a href={link.href} class="site-footer-link">{link.label}</a>
        ))}
      </div>
    </div>

    <div class="site-footer-group">
      <div class="site-footer-title">联系我们</div>
      <div class="site-footer-contact-list">
        <div class="site-footer-contact-item"><Icon name="phone" class="site-footer-contact-icon" /> <span>{siteMeta.phone}</span></div>
        <div class="site-footer-contact-item"><Icon name="mail" class="site-footer-contact-icon" /> <span>{siteMeta.email}</span></div>
        <div class="site-footer-contact-item"><Icon name="globe" class="site-footer-contact-icon" /> <span>{siteMeta.website}</span></div>
        <div class="site-footer-contact-item"><Icon name="map" class="site-footer-contact-icon" /> <span>{siteMeta.address}</span></div>
      </div>
    </div>
  </div>

  <div class="site-footer-bottom">
    <div class="container-shell site-footer-bottom-inner">
      <span>© 2026 {siteMeta.name} 版权所有</span>
      <span>{siteMeta.icp}</span>
    </div>
  </div>
</footer>