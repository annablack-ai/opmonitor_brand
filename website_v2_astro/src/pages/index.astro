<script is:inline>
  const tabs = document.querySelectorAll('[data-product]');
  const panels = document.querySelectorAll('[data-product-panel]');

  const setActivePanel = (key) => {
    tabs.forEach((tab) => {
      const isActive = tab.getAttribute('data-product') === key;
      tab.classList.toggle('is-active', isActive);
      tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
    });

    panels.forEach((panel) => {
      const isActive = panel.getAttribute('data-product-panel') === key;
      panel.classList.toggle('is-active', isActive);
      panel.hidden = !isActive;
    });
  };

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => setActivePanel(tab.getAttribute('data-product')));
  });
</script>
