---
interface Props {
  imageSrc: string;
  imageAlt: string;
  steps: string[];
}

const { imageSrc, imageAlt, steps } = Astro.props;
---

<div class="grid gap-6 lg:grid-cols-[1.08fr_0.92fr] lg:items-start">
  <div class="section-frame overflow-hidden">
    <div class="flex items-start justify-between gap-4">
      <div>
        <div class="eyebrow">业务流程图</div>
        <div class="mt-3 text-base leading-7 text-ink-500">围绕关键作业节点形成标准化记录、责任交接与台账归档。</div>
      </div>
      <div class="section-sidecard min-w-[7.5rem] text-right">
        <div class="section-kicker">流程环节</div>
        <div class="mt-2 text-3xl font-semibold tracking-[-0.05em] text-ink-900">{String(steps.length).padStart(2, '0')}</div>
      </div>
    </div>

    <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      {steps.map((step, index) => (
        <div class="relative rounded-[24px] bg-white/84 px-5 py-5 ring-1 ring-white/80">
          <div class="eyebrow">环节 {String(index + 1).padStart(2, '0')}</div>
          <div class="mt-3 text-base font-semibold text-ink-900">{step}</div>
          {index < steps.length - 1 && <div class="absolute -right-3 top-1/2 hidden h-px w-6 bg-brand-200 xl:block"></div>}
        </div>
      ))}
    </div>
  </div>

  <div class="image-frame product-visual-card bg-white p-4 md:p-5">
    <div class="flex items-start justify-between gap-4 px-2 pt-2">
      <div>
        <div class="eyebrow">流程示意</div>
        <div class="mt-2 text-sm leading-7 text-ink-500">以可视化方式呈现业务处理顺序与交接逻辑。</div>
      </div>
    </div>
    <img src={imageSrc} alt={imageAlt} class="mt-4 w-full rounded-[22px]" loading="lazy" />
  </div>
</div>