---
import Button from '@/components/Button.astro';
import type { ProductSummary } from '@/types/site';

interface Props {
  products: ProductSummary[];
}

const { products } = Astro.props;

const shortLabelMap: Record<string, string> = {
  'medical-waste': '医废追溯',
  'hazardous-waste': '危废管理',
  'health-supervision': '智慧卫监',
  'sterilization-monitoring': '消毒灭菌',
  'endoscope-compliance': '内镜合规',
  'carbon-management': '碳管理',
};

const homepagePanelCopy: Record<string, { tag: string; lead: string; points: string[]; note: string }> = {
  'medical-waste': {
    tag: '医疗卫生',
    lead: '围绕院内收集、称重交接、暂存出库与处置交接，帮助医疗机构实现全过程留痕、责任追溯与规范管理。',
    points: ['覆盖院内收集、称重交接、暂存出库等关键环节', '支持全过程留痕、责任追溯与异常提醒', '适配医疗机构日常作业与管理要求', '支撑医废规范化、可追溯、可闭环管理'],
    note: '适用于医院、院区及医疗集团的医废合规管理场景。',
  },
  'hazardous-waste': {
    tag: '生态环境',
    lead: '围绕产生、包装、称重、打码、入库等作业节点，支撑危险废物全过程规范化管理。',
    points: ['支持标签赋码、扫码入库与出库交接', '支持联单关联与过程留痕', '支持多节点责任追溯', '提升危废规范化管理效率'],
    note: '适用于产废单位、园区平台及多主体协同管理场景。',
  },
  'health-supervision': {
    tag: '智慧监管',
    lead: '面向卫生监督与在线监测场景，支持实时预警、非现场监管、问题整改与过程留痕。',
    points: ['支持多类在线监测与预警接入', '支持非现场监管与问题闭环', '支持过程留痕与监管协同', '适配公共卫生监督相关场景'],
    note: '适用于监管驾驶舱、在线监测与协同处置一体化场景。',
  },
  'sterilization-monitoring': {
    tag: '院感合规',
    lead: '围绕温度、压力等关键参数进行在线监测，辅助消毒灭菌过程留痕与异常提醒。',
    points: ['支持关键参数在线监测', '支持异常提醒与记录归档', '支持过程规范化管理', '适配消毒灭菌相关场景'],
    note: '适用于灭菌设备、流程追踪与质量管理协同场景。',
  },
  'endoscope-compliance': {
    tag: '院感合规',
    lead: '支持内镜洗消流程记录、质量控制与接口对接，辅助内镜管理合规化。',
    points: ['支持洗消流程留痕', '支持质量控制与状态管理', '支持接口对接与数据联动', '提升内镜管理规范性'],
    note: '适用于内镜中心、洗消流程与跨系统数据联动场景。',
  },
  'carbon-management': {
    tag: '减污降碳',
    lead: '基于固废、危废、医废过程记录，拓展碳账基础与减污降碳协同分析能力。',
    points: ['支持过程数据沉淀', '支持重量记录与流向记录', '支持碳账基础与协同分析', '适配园区集团与综合治理场景'],
    note: '适用于集团管理、综合治理与减污降碳协同分析场景。',
  },
};
---

<div class="overflow-hidden" data-product-showcase>
  <div class="overflow-x-auto border-b border-ink-200 pb-1">
    <div class="grid min-w-[52rem] grid-cols-6 gap-2 md:min-w-0">
      {products.map((product, index) => (
        <button
          type="button"
          class={`relative flex min-h-[5.5rem] flex-col items-center justify-center gap-3 px-3 py-4 text-sm font-semibold transition-colors duration-200 ${index === 0 ? 'text-brand-600' : 'text-ink-500 hover:text-ink-800'}`}
          data-showcase-tab={product.slug}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          <span class={`pointer-events-none absolute inset-x-5 bottom-0 h-0.5 rounded-full transition-colors duration-200 ${index === 0 ? 'bg-brand-500' : 'bg-transparent'}`} data-showcase-indicator></span>
          <span class={`inline-flex h-8 w-8 items-center justify-center rounded-full transition-colors duration-200 ${index === 0 ? 'bg-brand-50/90 text-brand-600' : 'bg-ink-50 text-ink-400'}`} data-showcase-icon-shell>
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true">
              {product.slug === 'medical-waste' && <><rect x="6" y="6" width="12" height="12" rx="3"></rect><path d="M12 3v3"></path><path d="M12 18v3"></path><path d="M3 12h3"></path><path d="M18 12h3"></path><path d="M9 9h6"></path><path d="M9 12h6"></path><path d="M12 9v6"></path></>}
              {product.slug === 'hazardous-waste' && <><path d="M12 4l7 12H5L12 4z"></path><path d="M12 9v4"></path><circle cx="12" cy="16.5" r="0.9" fill="currentColor" stroke="none"></circle><path d="M7 18h10"></path><path d="M9 20h6"></path></>}
              {product.slug === 'health-supervision' && <><path d="M5 17h14"></path><path d="M7 17V8"></path><path d="M17 17V6"></path><path d="M12 17v-4"></path><circle cx="7" cy="8" r="1.4"></circle><circle cx="12" cy="13" r="1.4"></circle><circle cx="17" cy="6" r="1.4"></circle><path d="M7 8l5 5 5-7"></path></>}
              {product.slug === 'sterilization-monitoring' && <><circle cx="12" cy="12" r="5"></circle><path d="M12 4v3"></path><path d="M12 17v3"></path><path d="M4 12h3"></path><path d="M17 12h3"></path><path d="M7.8 7.8l2.1 2.1"></path><path d="M14.1 14.1l2.1 2.1"></path></>}
              {product.slug === 'endoscope-compliance' && <><path d="M5 13h5"></path><path d="M10 13c3 0 4-4 7-4"></path><path d="M17 9c1.7 0 3 1.3 3 3s-1.3 3-3 3"></path><circle cx="8" cy="13" r="1.5"></circle><path d="M8 13v4a2 2 0 0 0 2 2h5"></path></>}
              {product.slug === 'carbon-management' && <><path d="M7 15c0-4 3-7 7-8 1.8 3.7 1 8.3-2.6 10.2C9.7 18 7 17.5 7 15z"></path><path d="M10.5 14c1 0 1.8.8 1.8 1.8"></path><path d="M14 11c1.7 0 3.2 1.4 3.2 3.2"></path><path d="M5 19h14"></path></>}
            </svg>
          </span>
          <span>{shortLabelMap[product.slug] ?? product.name}</span>
        </button>
      ))}
    </div>
  </div>

  <div class="mt-8 min-h-[29rem]">
    {products.map((product, index) => {
      const href = product.detailReady ? `/products/${product.slug}/` : '/products/';
      const copy = homepagePanelCopy[product.slug] ?? {
        tag: product.category,
        lead: product.excerpt,
        points: product.highlights,
        note: product.overview,
      };
      return (
        <section class={`${index === 0 ? 'grid' : 'hidden'} gap-10 lg:grid-cols-[0.42fr_0.58fr] lg:items-center`} data-showcase-panel={product.slug}>
          <div class="max-w-xl py-3">
            <div class="inline-flex items-center rounded-full border border-ink-200 bg-ink-50/80 px-3 py-1 text-xs font-bold tracking-[0.04em] text-ink-500">{copy.tag}</div>
            <h3 class="mt-5 text-[2rem] font-semibold leading-[1.12] tracking-[-0.04em] text-ink-900 md:text-[2.75rem]">{product.name}</h3>
            <p class="mt-5 text-base leading-8 text-ink-600">{copy.lead}</p>

            <ul class="mt-6 grid gap-3 text-sm leading-7 text-ink-600">
              {copy.points.map((item) => (
                <li class="relative pl-5 before:absolute before:left-0 before:top-[0.8rem] before:h-1.5 before:w-1.5 before:rounded-full before:bg-brand-500 before:content-['']">{item}</li>
              ))}
            </ul>

            <div class="mt-6 rounded-[1.1rem] bg-ink-50/70 px-4 py-4 text-sm leading-7 text-ink-500">{copy.note}</div>

            <div class="mt-8 flex flex-wrap items-center gap-4">
              <Button href={href}>了解更多</Button>
              <Button href="/products/" variant="secondary">查看全部方案</Button>
            </div>
          </div>

          <div class="tech-constellation min-h-[20rem] lg:min-h-[27rem]">
            <div class="tech-orbit"></div>
            <div class="tech-core"></div>
            <span class="tech-node h-4 w-4" style="left: 18%; top: 27%;"></span>
            <span class="tech-node h-4.5 w-4.5" style="left: 73%; top: 24%;"></span>
            <span class="tech-node h-3.5 w-3.5" style="left: 28%; top: 72%;"></span>
            <span class="tech-node h-3.5 w-3.5" style="left: 78%; top: 66%;"></span>
            <span class="tech-link" style="left: 21%; top: 30%; width: 28%; transform: rotate(15deg);"></span>
            <span class="tech-link" style="left: 50%; top: 48%; width: 22%; transform: rotate(-30deg);"></span>
            <span class="tech-link" style="left: 33%; top: 70%; width: 22%; transform: rotate(-12deg);"></span>
            <div class="relative flex h-full flex-col justify-between p-6">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <div class="eyebrow">方案能力结构</div>
                  <div class="mt-2 text-sm font-medium text-ink-500">围绕智能感知、业务留痕、风险提醒与合规闭环形成统一交付</div>
                </div>
                <span class="inline-flex rounded-full border border-brand-100 bg-white/86 px-3 py-1 text-xs font-semibold text-brand-600">
                  {shortLabelMap[product.slug] ?? product.name}
                </span>
              </div>

              <div class="mt-8 grid gap-4 lg:grid-cols-[1.05fr_0.95fr]">
                <div class="rounded-[20px] bg-white/74 p-5">
                  <div class="eyebrow">平台能力</div>
                  <svg viewBox="0 0 360 220" class="mt-6 h-[13rem] w-full text-brand-500" fill="none" aria-hidden="true">
                    <circle cx="180" cy="110" r="58" fill="rgba(255,255,255,0.76)" stroke="rgba(148,163,184,0.16)" />
                    <circle cx="180" cy="110" r="24" fill="rgba(59,130,246,0.09)" stroke="rgba(59,130,246,0.26)" />
                    <circle cx="92" cy="68" r="11" fill="rgba(59,130,246,0.16)" />
                    <circle cx="276" cy="78" r="10" fill="rgba(56,189,248,0.15)" />
                    <circle cx="268" cy="154" r="12" fill="rgba(59,130,246,0.12)" />
                    <circle cx="102" cy="156" r="9" fill="rgba(56,189,248,0.12)" />
                    <path d="M104 72c28 10 44 18 66 30" stroke="rgba(59,130,246,0.24)" stroke-width="1.4" />
                    <path d="M258 82c-26 12-42 18-62 28" stroke="rgba(59,130,246,0.24)" stroke-width="1.4" />
                    <path d="M258 150c-26-10-42-16-62-24" stroke="rgba(56,189,248,0.22)" stroke-width="1.4" />
                    <path d="M112 154c24-10 39-16 58-24" stroke="rgba(56,189,248,0.22)" stroke-width="1.4" />
                  </svg>
                </div>

                <div class="grid gap-4">
                  <div class="rounded-[20px] bg-white/74 p-5">
                    <div class="eyebrow">应用对象</div>
                    <p class="mt-3 text-sm leading-7 text-ink-600">{product.targetUsers.join('、')}</p>
                  </div>
                  <div class="rounded-[20px] bg-white/74 px-5 py-5 text-ink-700">
                    <div class="eyebrow">方案亮点</div>
                    <div class="mt-4 flex flex-wrap gap-2">
                      {copy.points.slice(0, 4).map((item) => <span class="chip">{item}</span>)}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      );
    })}
  </div>
</div>

<script is:inline>
  const rootList = document.querySelectorAll('[data-product-showcase]');

  rootList.forEach((root) => {
    const tabs = root.querySelectorAll('[data-showcase-tab]');
    const panels = root.querySelectorAll('[data-showcase-panel]');

    const setActive = (slug) => {
      tabs.forEach((tab) => {
        const isActive = tab.getAttribute('data-showcase-tab') === slug;
        tab.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        tab.classList.toggle('text-brand-600', isActive);
        tab.classList.toggle('text-ink-500', !isActive);
        tab.classList.toggle('hover:text-ink-800', !isActive);
        const iconShell = tab.querySelector('[data-showcase-icon-shell]');
        const indicator = tab.querySelector('[data-showcase-indicator]');
        if (iconShell) {
          iconShell.classList.toggle('bg-brand-50/90', isActive);
          iconShell.classList.toggle('text-brand-600', isActive);
          iconShell.classList.toggle('bg-ink-50', !isActive);
          iconShell.classList.toggle('text-ink-400', !isActive);
        }
        if (indicator) {
          indicator.classList.toggle('bg-brand-500', isActive);
          indicator.classList.toggle('bg-transparent', !isActive);
        }
      });

      panels.forEach((panel) => {
        const isActive = panel.getAttribute('data-showcase-panel') === slug;
        panel.classList.toggle('hidden', !isActive);
        panel.classList.toggle('grid', isActive);
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => setActive(tab.getAttribute('data-showcase-tab')));
    });
  });
</script>