---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="max-w-3xl">
  <div class="eyebrow">{eyebrow}</div>
  <h2 class="section-title mt-3">{title}</h2>
  {description && <p class="body-large mt-4">{description}</p>}
</div>